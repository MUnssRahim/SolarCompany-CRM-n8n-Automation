# Copy this file to .env.local and fill in real values. Never commit real secrets.

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# n8n webhooks (public, called from frontend forms)
NEXT_PUBLIC_N8N_LEAD_WEBHOOK=
NEXT_PUBLIC_N8N_QUOTE_WEBHOOK=
NEXT_PUBLIC_N8N_MEETING_WEBHOOK=
# NOT USED: the admin dashboard reads Supabase directly instead — this
# webhook just has n8n read the same tables, several seconds slower.
NEXT_PUBLIC_N8N_DASHBOARD_WEBHOOK=

# n8n instance base URL — only used to build a direct link from the Agents
# admin page to each workflow in n8n's own editor.
N8N_BASE_URL=
# NOT USED: the n8n REST API (list/activate/deactivate workflows) needs a
# paid n8n plan. This project runs on the free trial, so there is no
# activation control in the app — leave this unset.
N8N_API_KEY=

# n8n workflow IDs (server-side only — one per Agents admin page card, used
# only to build the "View Workflow in n8n" link).
N8N_WORKFLOW_ID_LEAD_CAPTURE=
N8N_WORKFLOW_ID_QUOTE_GENERATION=
N8N_WORKFLOW_ID_MEETING_BOOKING=
N8N_WORKFLOW_ID_FOLLOW_UP=
