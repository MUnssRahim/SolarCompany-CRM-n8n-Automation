    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const b = $json.body || {};\nconst monthly_bill = Number(b.monthly_bill) || 0;\nconst usage_kwh = Number(b.usage_kwh) || 0;\nconst roof_area = b.roof_area != null ? Number(b.roof_area) : null;\n\nconst system_size_kw = usage_kwh / (30 * 4.5);\nconst num_panels = Math.ceil(system_size_kw / 0.55);\nconst estimated_cost = system_size_kw * 170000;\nconst monthly_savings = monthly_bill * 0.85;\nconst payback_years = monthly_savings > 0 ? estimated_cost / (monthly_savings * 12) : 0;\n\nreturn {\n  name: b.name,\n  email: b.email,\n  phone: b.phone,\n  city: b.city,\n  monthly_bill,\n  usage_kwh,\n  roof_area,\n  system_size_kw: Math.round(system_size_kw * 100) / 100,\n  num_panels,\n  estimated_cost: Math.round(estimated_cost),\n  monthly_savings: Math.round(monthly_savings * 100) / 100,\n  payback_years: Math.round(payback_years * 100) / 100,\n};"
      },
      "id": "99a80219-922f-4c21-ad5d-e73687742b49",
